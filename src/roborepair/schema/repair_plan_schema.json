{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured robot-program repair plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_schema_version",
    "source_episode_id",
    "task_id",
    "primary_failure",
    "secondary_failures",
    "initial_progress",
    "achieved_subgoals",
    "missing_subgoals",
    "causal_state",
    "repair_mode",
    "repair_intent",
    "must_preserve",
    "must_change",
    "forbidden_patterns",
    "verification_checklist",
    "compiler_rule_ids",
    "confidence"
  ],
  "properties": {
    "plan_schema_version": {
      "const": "2.0"
    },
    "source_episode_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "enum": [
        "cube_lift",
        "cube_stack"
      ]
    },
    "primary_failure": {
      "type": "string",
      "minLength": 1
    },
    "secondary_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "initial_progress": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "achieved_subgoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_subgoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "causal_state": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "number",
          "string"
        ]
      }
    },
    "repair_mode": {
      "type": "string",
      "enum": [
        "patch",
        "regenerate"
      ]
    },
    "repair_intent": {
      "type": "string",
      "minLength": 1
    },
    "must_preserve": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_change": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "compiler_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
